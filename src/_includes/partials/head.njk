	<meta name="referrer" content="no-referrer">
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>{{ page.title }}</title>
	<script>
	/* 首帧前同步设置 data-theme，避免主题背景/图标闪烁（FOUC） */
	(function () {
		var t;
		try { t = sessionStorage.getItem('user-theme'); } catch (e) {}
		if (t !== 'dark' && t !== 'light') {
			t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
		}
		document.documentElement.setAttribute('data-theme', t);
	})();
	</script>
	{% if page.noindex %}<meta name="robots" content="noindex, nofollow">{% endif %}
	{% if page.description %}<meta name="description" content="{{ page.description }}">{% endif %}
	{% if page.url %}<link rel="canonical" href="{{ page.url }}">{% endif %}
	<meta property="og:site_name" content="Ethan Shaw">
	<meta property="og:type" content="website">
	<meta property="og:title" content="{{ page.title }}">
	{% if page.description %}<meta property="og:description" content="{{ page.description }}">{% endif %}
	{% if page.url %}<meta property="og:url" content="{{ page.url }}">{% endif %}
	<meta property="og:locale" content="{{ page.htmlLang }}">
	<link rel="icon" href="{{ page.root }}favicon.webp" type="image/webp">
	<!-- 除中文外，字体全部自托管（见 tools/build-fonts.py），@font-face 就写在 main.css 里，
	     浏览器解析到即开始下载，不需要额外的字体 CSS 请求。中文见下面的 cjk-font 区块。 -->
	{% if page.preload %}
	<!-- 首屏图在 <body> 里才会被发现，这里提前到 <head> 发起；只写单一候选，
	     配上 imagesrcset 会让 Chromium 先按 1x 猜一张、再按实际 DPR 换一张 -->
	<link rel="preload" href="{{ page.root }}images/{{ page.preload }}" as="image" type="image/avif" fetchpriority="high">
	{% endif %}
	<!-- 只 preload「不 preload 就会明显出问题」的字体。
	     crossorigin 是字体请求的硬性要求，同源也要写，否则会重复下载。
	     Google Sans Flex 用于各页的 .section-title / h1，因 font-display:block 必须 preload；
	     Inter 是 font-display:swap 的正文体，解析 main.css 时就会开始下载，不再占用 preload 名额；
	     中文（思源黑体）使用本地子集，但不 preload，等 main.css 按需触发下载。 -->
	<link rel="preload" href="{{ page.root }}css/fonts/{{ fontFile('GoogleSansFlex.woff2') }}" as="font" type="font/woff2" crossorigin>
	<!-- 图标字体（ligature）用于卡片/导航内的图标，字体在 main.css 里才被发现；
	     它 font-display:auto 等同 block，不 preload 会在慢网下让图标空白最多 3s。 -->
	<link rel="preload" href="{{ page.root }}css/fonts/{{ fontFile('Icons-Regular.woff2') }}" as="font" type="font/woff2" crossorigin>
	<!-- 中文（思源黑体 / Noto Sans SC）：
	     1. 本地子集（family 名 `Noto Sans SC Local`，约 300 KB，字体栈里排第一位）承担日常全部字符，
	        不预加载；浏览器解析 main.css 并确认页面实际用到该字体后才下载，之后由 immutable 长缓存复用。
	     2. Google Fonts 只做兜底：本地子集缺字时（构建在无 Python 的 CI 上没能补字，或以后新增的生僻字）
	        才由它的 unicode-range 分片接手。用 media="print" 异步加载，不阻塞首帧，
	        Google 不可达时也只是几个连接干等超时，不影响渲染。
	     正文没有 CJK 的页面由 build.js 把整段删掉，那些页面不会有任何第三方请求。 -->
	<!-- cjk-font:start -->
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@100..900&display=swap" media="print" onload="this.media='all'">
	<noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@100..900&display=swap"></noscript>
	<!-- cjk-font:end -->
	{% if page.preconnect %}{% for origin in page.preconnect %}
	<link rel="preconnect" href="{{ origin }}">{% endfor %}
	{% endif %}
	<link rel="stylesheet" href="{{ page.root }}css/main.css">
	{% for css in page.css %}
	<link rel="stylesheet" href="{{ page.root }}css/{{ css }}">
	{% endfor %}
	{% if page.inlineHead %}{{ page.inlineHead | safe }}
	{% endif %}
	<script src="{{ page.root }}js/core.js" defer></script>
	<script src="{{ page.root }}js/cjk-gap.js" defer></script>
	{% if page.lang === 'zh' %}<script src="{{ page.root }}js/typography.js" defer></script>
	{% endif %}
	{% for js in page.js %}
	<script src="{{ page.root }}js/{{ js }}" defer></script>
	{% endfor %}
