	<meta name="referrer" content="no-referrer">
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>{{ page.title }}</title>
	<script>
	/* 首帧前同步设置 data-theme，避免主题背景/图标闪烁（FOUC） */
	(function () {
		var t;
		try { t = sessionStorage.getItem('user-theme'); } catch (e) {}
		if (t !== 'dark' && t !== 'light') {
			t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
		}
		document.documentElement.setAttribute('data-theme', t);
	})();
	</script>
	{% if page.noindex %}<meta name="robots" content="noindex, nofollow">{% endif %}
	{% if page.description %}<meta name="description" content="{{ page.description }}">{% endif %}
	{% if page.url %}<link rel="canonical" href="{{ page.url }}">{% endif %}
	<meta property="og:site_name" content="Ethan Shaw">
	<meta property="og:type" content="website">
	<meta property="og:title" content="{{ page.title }}">
	{% if page.description %}<meta property="og:description" content="{{ page.description }}">{% endif %}
	{% if page.url %}<meta property="og:url" content="{{ page.url }}">{% endif %}
	<meta property="og:locale" content="{{ page.htmlLang }}">
	<link rel="icon" href="../favicon.webp" type="image/webp">
	<!-- 字体全部自托管（见 tools/build-fonts.py），不再有跨域的 Google Fonts / rsms.me 请求，
	     所以也不需要 preconnect。@font-face 在 main.css 里，浏览器解析到即开始下载。 -->
	{% if page.preload %}
	<!-- 首屏图在 <body> 里才会被发现，这里提前到 <head> 发起；只写单一候选，
	     配上 imagesrcset 会让 Chromium 先按 1x 猜一张、再按实际 DPR 换一张 -->
	<link rel="preload" href="../images/{{ page.preload }}" as="image" type="image/avif" fetchpriority="high">
	{% endif %}
	<!-- 首屏正文用到的两个字体（拉丁 + 中文）提前拉取，与 HTML 并行；其余字体按需加载。
	     crossorigin 是字体请求的硬性要求，同源也要写，否则会重复下载。 -->
	<link rel="preload" href="../css/fonts/Inter.woff2" as="font" type="font/woff2" crossorigin>
	<link rel="preload" href="../css/fonts/NotoSansSC.woff2" as="font" type="font/woff2" crossorigin>
	{% if page.preload %}
	<link rel="preload" href="../css/fonts/GoogleSansFlex.woff2" as="font" type="font/woff2" crossorigin>
	{% endif %}
	{% if page.preconnect %}{% for origin in page.preconnect %}
	<link rel="preconnect" href="{{ origin }}">{% endfor %}
	{% endif %}
	<link rel="stylesheet" href="../css/main.css">
	{% for css in page.css %}
	<link rel="stylesheet" href="../css/{{ css }}">
	{% endfor %}
	{% if page.inlineHead %}{{ page.inlineHead | safe }}
	{% endif %}
	<script src="../js/core.js" defer></script>
	<script src="../js/cjk-gap.js" defer></script>
	{% if page.lang === 'zh' %}<script src="../js/typography.js" defer></script>
	{% endif %}
	{% for js in page.js %}
	<script src="../js/{{ js }}" defer></script>
	{% endfor %}
