{% extends "_includes/layout.njk" %}

{% block content %}
	<header class="page-hero">
		<section class="hero-content">
			<div>
				<h1>联系支持</h1>
				<p class="tagline">交个朋友，或者……买杯咖啡？</p>
			</div>
		</section>
	</header>

	<main class="content-section">
		<section class="container">
			<section class="main-container">
				<section id="email" class="section-content grid">
					<a href="mailto:ethanshaw@ethan929.com" class="card" onclick="toggleModal('email-overlay', true)">
						<span class="card-subtitle"><icons>EMAIL</icons> 个人邮箱</span>
					</a>
					<div>
						<h2>ethanshaw@ethan929.com</h2>
						<p>期待与您的友好交流。</p>
						<p><i>如未收到回信，请检查垃圾邮件箱。</i></p>
					</div>
				</section>
				<section id="qq" class="section-content grid">
					<a href="javascript:void(0);" class="card qq" onclick="copyToClipboard('671065700', this)">
						<span class="card-subtitle"><icons>qq QQ</icons> 群</span>
					</a>
					<div>
						<h2>671065700</h2>
						<p class="bottom10">欢迎加入我们的群聊！</p>
						<div class="main-text">
							<p><strong>注意</strong>　加入群聊需经过群管理人员审核，问题为：「群主中文频道名称是？」输入「卡布米袋里的音符」方可进群。</p>
						</div>
					</div>
				</section>
				<section id="discord" class="section-content grid">
					<a href="https://discord.gg/ffpcn44j38" class="card discord" onclick="toggleModal('discord-overlay', true)">
						<span class="card-subtitle"><icons>discord Discord</icons> 服务器</span>
					</a>
					<div>
						<h2>Charlie's Melody Bag</h2>
						<p class="bottom10">欢迎加入我们的服务器！</p>
						<div class="main-text">
							<p><strong>注意</strong>　加入服务器需提交申请，问题为：「Who is your favorite Chinese pop singer?」（您最喜欢的中国流行歌手是谁？）输入「周深」（或「Zhou Shen」「Charlie Zhou」等）后等待审核通过即可。</p>
						</div>
					</div>
				</section>
				<section id="github" class="section-content grid">
					<a href="https://github.com/KabulMus" class="card black">
						<span class="card-subtitle"><icons>github GitHub</icons></span>
					</a>
					<div>
						<h2>KabulMus</h2>
						<p>探索我的更多开源项目！</p>
					</div>
				</section>
				<section id="reward" class="section-content grid">
					<a href="javascript:void(0);" class="card wechat" onclick="toggleModal('modal-overlay', true)">
						<span class="card-subtitle"><icons>wechatpay WeixinZhifu</icons> 赞赏码</span>
					</a>
					<p>感谢您的鼓励与支持！</p>
				</section>
				<section id="duolingo" class="section-content grid">
					<a href="https://www.duolingo.com/profile/EthanShaw929" class="card duolingo" target="_blank">
						<span class="card-subtitle"><icons>duo duolinguo</icons></span>
					</a>
					<div>
						<h2>EthanShaw929</h2>
						<p>来多邻国一起学习吧！</p>
					</div>
				</section>
			</section>

			{% include "_includes/partials/footer.njk" %}
		</section>
	</main>

	<!-- 微信 -->
	<section id="modal-overlay" class="modal-overlay" onclick="toggleModal('modal-overlay', false)">
		<article class="modal-modal" onclick="event.stopPropagation()">
			<button class="close-btn" onclick="toggleModal('modal-overlay', false)" aria-label="关闭弹窗">
				<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 6L6 18M6 6L18 18"></path></svg>
			</button>
			<div class="modal-body">
				<h4 style="margin-bottom: 20px; color: var(--text-main); font-weight: 600;">赞赏码</h4>
				<picture>
					<source srcset="../images/reward_code_dark.webp" media="(prefers-color-scheme: dark)">
					<img src="../images/reward_code.webp" alt="微信赞赏码" class="modal-qr">
				</picture>
				<p style="margin-top: 15px; font-size: 0.85rem; color: var(--text-sub);">感谢您的鼓励与支持！</p>
			</div>
		</article>
	</section>
{% endblock %}
