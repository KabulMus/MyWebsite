{% extends "_includes/layout.njk" %}

{% block content %}
	<header class="page-hero">
		<section class="hero-content">
			<div>
				<h1>音阶构成</h1>
				<p class="tagline">12 个常用大调的音阶构成</p>
			</div>
		</section>
	</header>

	<main class="content-section">
		<section class="container">
			<div class="notation-toggle">
				<button class="notation-btn" onclick="setNotation('sharp', this)">#</button>
				<button class="notation-btn active" onclick="setNotation('flat', this)">b</button>
			</div>

			<div class="filter-container">
				<button class="filter-btn" onclick="filterScale(this)">C</button>
				<button class="filter-btn" onclick="filterScale(this)">Db</button>
				<button class="filter-btn" onclick="filterScale(this)">D</button>
				<button class="filter-btn" onclick="filterScale(this)">Eb</button>
				<button class="filter-btn" onclick="filterScale(this)">E</button>
				<button class="filter-btn" onclick="filterScale(this)">F</button>
				<button class="filter-btn" onclick="filterScale(this)">Gb</button>
				<button class="filter-btn" onclick="filterScale(this)">G</button>
				<button class="filter-btn" onclick="filterScale(this)">Ab</button>
				<button class="filter-btn" onclick="filterScale(this)">A</button>
				<button class="filter-btn" onclick="filterScale(this)">Bb</button>
				<button class="filter-btn" onclick="filterScale(this)">B</button>
			</div>

			<div class="scales-grid">
				<!-- C Major -->
				<div class="card scale-card">
					<div class="scale-header"><span class="scale-name"><span class="musical-key">C</span> Major</span><span class="scale-type"><span class="musical-key">A</span> minor</span></div>
					<div class="note-list"><span class="note-badge"><i>I</i><span>C</span></span><span class="note-badge"><i>II</i><span>D</span></span><span class="note-badge"><i>III</i><span>E</span></span><span class="note-badge"><i>IV</i><span>F</span></span><span class="note-badge"><i>V</i><span>G</span></span><span class="note-badge"><i>VI</i><span>A</span></span><span class="note-badge"><i>VII</i><span>B</span></span></div>
				</div>
				<!-- G Major -->
				<div class="card scale-card">
					<div class="scale-header"><span class="scale-name"><span class="musical-key">G</span> Major</span><span class="scale-type"><span class="musical-key">E</span> minor</span></div>
					<div class="note-list"><span class="note-badge"><i>I</i><span>G</span></span><span class="note-badge"><i>II</i><span>A</span></span><span class="note-badge"><i>III</i><span>B</span></span><span class="note-badge"><i>IV</i><span>C</span></span><span class="note-badge"><i>V</i><span>D</span></span><span class="note-badge"><i>VI</i><span>E</span></span><span class="note-badge"><i>VII</i><span>F#</span></span></div>
				</div>
				<!-- D Major -->
				<div class="card scale-card">
					<div class="scale-header"><span class="scale-name"><span class="musical-key">D</span> Major</span><span class="scale-type"><span class="musical-key">B</span> minor</span></div>
					<div class="note-list"><span class="note-badge"><i>I</i><span>D</span></span><span class="note-badge"><i>II</i><span>E</span></span><span class="note-badge"><i>III</i><span>F#</span></span><span class="note-badge"><i>IV</i><span>G</span></span><span class="note-badge"><i>V</i><span>A</span></span><span class="note-badge"><i>VI</i><span>B</span></span><span class="note-badge"><i>VII</i><span>C#</span></span></div>
				</div>
				<!-- A Major -->
				<div class="card scale-card">
					<div class="scale-header"><span class="scale-name"><span class="musical-key">A</span> Major</span><span class="scale-type"><span class="musical-key">F#</span> minor</span></div>
					<div class="note-list"><span class="note-badge"><i>I</i><span>A</span></span><span class="note-badge"><i>II</i><span>B</span></span><span class="note-badge"><i>III</i><span>C#</span></span><span class="note-badge"><i>IV</i><span>D</span></span><span class="note-badge"><i>V</i><span>E</span></span><span class="note-badge"><i>VI</i><span>F#</span></span><span class="note-badge"><i>VII</i><span>G#</span></span></div>
				</div>
				<!-- E Major -->
				<div class="card scale-card">
					<div class="scale-header"><span class="scale-name"><span class="musical-key">E</span> Major</span><span class="scale-type"><span class="musical-key">C#</span> minor</span></div>
					<div class="note-list"><span class="note-badge"><i>I</i><span>E</span></span><span class="note-badge"><i>II</i><span>F#</span></span><span class="note-badge"><i>III</i><span>G#</span></span><span class="note-badge"><i>IV</i><span>A</span></span><span class="note-badge"><i>V</i><span>B</span></span><span class="note-badge"><i>VI</i><span>C#</span></span><span class="note-badge"><i>VII</i><span>D#</span></span></div>
				</div>
				<!-- B Major -->
				<div class="card scale-card">
					<div class="scale-header"><span class="scale-name"><span class="musical-key">B</span> Major</span><span class="scale-type"><span class="musical-key">G#</span> minor</span></div>
					<div class="note-list"><span class="note-badge"><i>I</i><span>B</span></span><span class="note-badge"><i>II</i><span>C#</span></span><span class="note-badge"><i>III</i><span>D#</span></span><span class="note-badge"><i>IV</i><span>E</span></span><span class="note-badge"><i>V</i><span>F#</span></span><span class="note-badge"><i>VI</i><span>G#</span></span><span class="note-badge"><i>VII</i><span>A#</span></span></div>
				</div>
				<!-- F# Major -->
				<div class="card scale-card">
					<div class="scale-header"><span class="scale-name"><span class="musical-key">F#</span> Major</span><span class="scale-type"><span class="musical-key">D#</span> minor</span></div>
					<div class="note-list"><span class="note-badge"><i>I</i><span>F#</span></span><span class="note-badge"><i>II</i><span>G#</span></span><span class="note-badge"><i>III</i><span>A#</span></span><span class="note-badge"><i>IV</i><span>B</span></span><span class="note-badge"><i>V</i><span>C#</span></span><span class="note-badge"><i>VI</i><span>D#</span></span><span class="note-badge"><i>VII</i><span><b style="font-weight: 600;">F</b><span style="font-weight: 300; opacity: 0.5; margin: 0 4px;">/</span><b style="font-weight: 600;">E#</b></span></span></div>
				</div>
				<!-- C# Major -->
				<div class="card scale-card">
					<div class="scale-header"><span class="scale-name"><span class="musical-key">C#</span> Major</span><span class="scale-type"><span class="musical-key">A#</span> minor</span></div>
					<div class="note-list"><span class="note-badge"><i>I</i><span>C#</span></span><span class="note-badge"><i>II</i><span>D#</span></span><span class="note-badge"><i>III</i><span><b style="font-weight: 600;">F</b><span style="font-weight: 300; opacity: 0.5; margin: 0 4px;">/</span><b style="font-weight: 600;">E#</b></span></span><span class="note-badge"><i>IV</i><span>F#</span></span><span class="note-badge"><i>V</i><span>G#</span></span><span class="note-badge"><i>VI</i><span>A#</span></span><span class="note-badge"><i>VII</i><span><b style="font-weight: 600;">C</b><span style="font-weight: 300; opacity: 0.5; margin: 0 4px;">/</span><b style="font-weight: 600;">B#</b></span></span></div>
				</div>
				<!-- G# Major -->
				<div class="card scale-card">
					<div class="scale-header"><span class="scale-name"><span class="musical-key">G#</span> Major</span><span class="scale-type"><span class="musical-key">F/E#</span> minor</span></div>
					<div class="note-list"><span class="note-badge"><i>I</i><span>G#</span></span><span class="note-badge"><i>II</i><span>A#</span></span><span class="note-badge"><i>III</i><span><b style="font-weight: 600;">C</b><span style="font-weight: 300; opacity: 0.5; margin: 0 4px;">/</span><b style="font-weight: 600;">B#</b></span></span><span class="note-badge"><i>IV</i><span>C#</span></span><span class="note-badge"><i>V</i><span>D#</span></span><span class="note-badge"><i>VI</i><span><b style="font-weight: 600;">F</b><span style="font-weight: 300; opacity: 0.5; margin: 0 4px;">/</span><b style="font-weight: 600;">E#</b></span></span><span class="note-badge"><i>VII</i><span><b style="font-weight: 600;">G</b><span style="font-weight: 300; opacity: 0.5; margin: 0 4px;">/</span><b style="font-weight: 600;">F##</b></span></span></div>
				</div>
				<!-- D# Major -->
				<div class="card scale-card">
					<div class="scale-header"><span class="scale-name"><span class="musical-key">D#</span> Major</span><span class="scale-type"><span class="musical-key">C/B#</span> minor</span></div>
					<div class="note-list"><span class="note-badge"><i>I</i><span>D#</span></span><span class="note-badge"><i>II</i><span><b style="font-weight: 600;">F</b><span style="font-weight: 300; opacity: 0.5; margin: 0 4px;">/</span><b style="font-weight: 600;">E#</b></span></span><span class="note-badge"><i>III</i><span><b style="font-weight: 600;">G</b><span style="font-weight: 300; opacity: 0.5; margin: 0 4px;">/</span><b style="font-weight: 600;">F##</b></span></span><span class="note-badge"><i>IV</i><span>G#</span></span><span class="note-badge"><i>V</i><span>A#</span></span><span class="note-badge"><i>VI</i><span><b style="font-weight: 600;">C</b><span style="font-weight: 300; opacity: 0.5; margin: 0 4px;">/</span><b style="font-weight: 600;">B#</b></span></span><span class="note-badge"><i>VII</i><span><b style="font-weight: 600;">D</b><span style="font-weight: 300; opacity: 0.5; margin: 0 4px;">/</span><b style="font-weight: 600;">C##</b></span></span></div>
				</div>
				<!-- A# Major -->
				<div class="card scale-card">
					<div class="scale-header"><span class="scale-name"><span class="musical-key">A#</span> Major</span><span class="scale-type"><span class="musical-key">G/F##</span> minor</span></div>
					<div class="note-list"><span class="note-badge"><i>I</i><span>A#</span></span><span class="note-badge"><i>II</i><span><b style="font-weight: 600;">C</b><span style="font-weight: 300; opacity: 0.5; margin: 0 4px;">/</span><b style="font-weight: 600;">B#</b></span></span><span class="note-badge"><i>III</i><span><b style="font-weight: 600;">D</b><span style="font-weight: 300; opacity: 0.5; margin: 0 4px;">/</span><b style="font-weight: 600;">C##</b></span></span><span class="note-badge"><i>IV</i><span>D#</span></span><span class="note-badge"><i>V</i><span><b style="font-weight: 600;">F</b><span style="font-weight: 300; opacity: 0.5; margin: 0 4px;">/</span><b style="font-weight: 600;">E#</b></span></span><span class="note-badge"><i>VI</i><span><b style="font-weight: 600;">G</b><span style="font-weight: 300; opacity: 0.5; margin: 0 4px;">/</span><b style="font-weight: 600;">F##</b></span></span><span class="note-badge"><i>VII</i><span><b style="font-weight: 600;">A</b><span style="font-weight: 300; opacity: 0.5; margin: 0 4px;">/</span><b style="font-weight: 600;">G##</b></span></span></div>
				</div>
				<!-- Gb Major -->
				<div class="card scale-card">
					<div class="scale-header"><span class="scale-name"><span class="musical-key">Gb</span> Major</span><span class="scale-type"><span class="musical-key">Eb</span> minor</span></div>
					<div class="note-list"><span class="note-badge"><i>I</i><span>Gb</span></span><span class="note-badge"><i>II</i><span>Ab</span></span><span class="note-badge"><i>III</i><span>Bb</span></span><span class="note-badge"><i>IV</i><span><b style="font-weight: 600;">B</b><span style="font-weight: 300; opacity: 0.5; margin: 0 4px;">/</span><b style="font-weight: 600;">Cb</b></span></span><span class="note-badge"><i>V</i><span>Db</span></span><span class="note-badge"><i>VI</i><span>Eb</span></span><span class="note-badge"><i>VII</i><span>F</span></span></div>
				</div>
				<!-- F Major -->
				<div class="card scale-card">
					<div class="scale-header"><span class="scale-name"><span class="musical-key">F</span> Major</span><span class="scale-type"><span class="musical-key">D</span> minor</span></div>
					<div class="note-list"><span class="note-badge"><i>I</i><span>F</span></span><span class="note-badge"><i>II</i><span>G</span></span><span class="note-badge"><i>III</i><span>A</span></span><span class="note-badge"><i>IV</i><span>Bb</span></span><span class="note-badge"><i>V</i><span>C</span></span><span class="note-badge"><i>VI</i><span>D</span></span><span class="note-badge"><i>VII</i><span>E</span></span></div>
				</div>
				<!-- Bb Major -->
				<div class="card scale-card">
					<div class="scale-header"><span class="scale-name"><span class="musical-key">Bb</span> Major</span><span class="scale-type"><span class="musical-key">G</span> minor</span></div>
					<div class="note-list"><span class="note-badge"><i>I</i><span>Bb</span></span><span class="note-badge"><i>II</i><span>C</span></span><span class="note-badge"><i>III</i><span>D</span></span><span class="note-badge"><i>IV</i><span>Eb</span></span><span class="note-badge"><i>V</i><span>F</span></span><span class="note-badge"><i>VI</i><span>G</span></span><span class="note-badge"><i>VII</i><span>A</span></span></div>
				</div>
				<!-- Eb Major -->
				<div class="card scale-card">
					<div class="scale-header"><span class="scale-name"><span class="musical-key">Eb</span> Major</span><span class="scale-type"><span class="musical-key">C</span> minor</span></div>
					<div class="note-list"><span class="note-badge"><i>I</i><span>Eb</span></span><span class="note-badge"><i>II</i><span>F</span></span><span class="note-badge"><i>III</i><span>G</span></span><span class="note-badge"><i>IV</i><span>Ab</span></span><span class="note-badge"><i>V</i><span>Bb</span></span><span class="note-badge"><i>VI</i><span>C</span></span><span class="note-badge"><i>VII</i><span>D</span></span></div>
				</div>
				<!-- Ab Major -->
				<div class="card scale-card">
					<div class="scale-header"><span class="scale-name"><span class="musical-key">Ab</span> Major</span><span class="scale-type"><span class="musical-key">F</span> minor</span></div>
					<div class="note-list"><span class="note-badge"><i>I</i><span>Ab</span></span><span class="note-badge"><i>II</i><span>Bb</span></span><span class="note-badge"><i>III</i><span>C</span></span><span class="note-badge"><i>IV</i><span>Db</span></span><span class="note-badge"><i>V</i><span>Eb</span></span><span class="note-badge"><i>VI</i><span>F</span></span><span class="note-badge"><i>VII</i><span>G</span></span></div>
				</div>
				<!-- Db Major -->
				<div class="card scale-card">
					<div class="scale-header"><span class="scale-name"><span class="musical-key">Db</span> Major</span><span class="scale-type"><span class="musical-key">Bb</span> minor</span></div>
					<div class="note-list"><span class="note-badge"><i>I</i><span>Db</span></span><span class="note-badge"><i>II</i><span>Eb</span></span><span class="note-badge"><i>III</i><span>F</span></span><span class="note-badge"><i>IV</i><span>Gb</span></span><span class="note-badge"><i>V</i><span>Ab</span></span><span class="note-badge"><i>VI</i><span>Bb</span></span><span class="note-badge"><i>VII</i><span>C</span></span></div>
				</div>
			</div>

			{% include "_includes/partials/footer.njk" %}
		</section>
	</main>
{% endblock %}
